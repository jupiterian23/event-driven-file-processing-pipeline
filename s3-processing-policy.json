{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInputObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::jupiterian23-event-pipeline-input/*"
    },
    {
      "Sid": "WriteProcessedObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::jupiterian23-event-pipeline-output/processed/*"
    }
  ]
}
